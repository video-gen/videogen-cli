{
  "name": "@videogen/cli",
  "version": "2.0.12",
  "description": "Command-line interface for the VideoGen API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "videogen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@videogen/sdk": "^2.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.19.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.14.0",
    "tsup": "^8.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.13.0"
  }
}
